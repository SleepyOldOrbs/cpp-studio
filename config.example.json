{
  "gateway": {
    "host": "127.0.0.1",
    "port": 8765
  },
  "vars": {
    "root": "C:\\path\\to\\your\\studio"
  },
  "models": {
    "manifest": "${configDir}/models.json",
    "root": "${root}\\models",
    "discovery": {
      "pythonCommand": "python",
      "managerScript": "${root}\\..\\audio.cpp\\tools\\model_manager_v2.py",
      "audioCli": "${root}\\..\\audio.cpp\\build\\windows-cuda-release\\bin\\audiocpp_cli.exe",
      "workingDir": "${root}\\..\\audio.cpp",
      "allowedPackages": ["dramabox_q8_0", "chatterbox_q8_0", "ace_step_turbo_q8_0"],
      "timeoutSeconds": 10
    }
  },
  "profiles": {
    "everything": [
      "llama", "whisper", "audio", "voiceconvert", "music", "sd",
      "qwen3-tts-1.7b-base", "qwen3-tts-1.7b-customvoice", "vibevoice", "fish-audio", "chatterbox-clone",
      "qwen3-asr-0.6b", "qwen3-asr-1.7b", "vibevoice-asr",
      "vevo2", "stable-audio-medium", "stable-audio-sfx", "heartmula",
      "htdemucs", "bs-roformer", "mel-band-roformer",
      "silero-vad", "marblenet-vad", "forced-aligner"
    ],
    "chat": ["llama", "whisper", "audio"],
    "art": ["sd"]
  },
  "engines": {
    "llama": {
      "command": "${root}\\engines\\llama-engines\\llama-server.exe",
      "args": [
        "--host", "127.0.0.1",
        "--port", "8733",
        "-m", "${root}\\models\\text\\Qwen3-4B-Instruct\\Qwen3-4B-Instruct-2507-Q4_K_M.gguf",
        "--jinja",
        "-ngl", "99",
        "-c", "8192",
        "-b", "512",
        "-ub", "256"
      ],
      "mode": "server",
      "healthUrl": "http://127.0.0.1:8733/health",
      "startupTimeoutSeconds": 120,
      "shutdownTimeoutSeconds": 10,
      "requestTimeoutSeconds": 120
    },
    "whisper": {
      "command": "${root}\\engines\\whisper-engines\\Release\\whisper-server.exe",
      "args": [
        "-m", "${root}\\models\\transcription\\Whisper\\ggml-base.en.bin",
        "--host", "127.0.0.1",
        "--port", "8734"
      ],
      "mode": "server",
      "healthUrl": "http://127.0.0.1:8734/health",
      "startupTimeoutSeconds": 30,
      "shutdownTimeoutSeconds": 5,
      "requestTimeoutSeconds": 120
    },
    "audio": {
      "command": "${root}\\engines\\audio-engines\\audiocpp_cli.exe",
      "args": [
        "--task", "tts",
        "--family", "qwen3_tts",
        "--model", "${root}\\models\\speech\\synthesis\\Qwen3-TTS-12Hz-0.6B-Base",
        "--backend", "cuda",
        "--voice-ref", "${root}\\..\\audio.cpp\\assets\\resources\\b.wav",
        "--reference-text", "Reference voice transcript.",
        "--max-tokens", "256",
        "--session-option", "qwen3_tts.weight_type=q8_0"
      ],
      "mode": "subprocess",
      "requestTimeoutSeconds": 180,
      "gpu": true
    },
    "qwen3-tts-1.7b-base": {
      "command": "${root}\\engines\\audio-engines\\audiocpp_cli.exe",
      "args": [
        "--task", "tts", "--family", "qwen3_tts",
        "--model", "${root}\\models\\speech\\synthesis\\Qwen3-TTS-12Hz-1.7B-Base-GGUF\\qwen3-tts-12hz-1.7b-base-q8_0_v2.gguf",
        "--backend", "cuda",
        "--voice-ref", "${root}\\..\\audio.cpp\\assets\\resources\\b.wav",
        "--reference-text", "Reference voice transcript."
      ],
      "mode": "subprocess",
      "requestTimeoutSeconds": 600,
      "gpu": true
    },
    "qwen3-tts-1.7b-customvoice": {
      "command": "${root}\\engines\\audio-engines\\audiocpp_cli.exe",
      "args": [
        "--task", "tts", "--family", "qwen3_tts",
        "--model", "${root}\\models\\speech\\synthesis\\Qwen3-TTS-12Hz-1.7B-CustomVoice-GGUF\\qwen3-tts-12hz-1.7b-customvoice-q8_0.gguf",
        "--backend", "cuda", "--speaker", "Vivian"
      ],
      "mode": "subprocess",
      "requestTimeoutSeconds": 600,
      "gpu": true
    },
    "vibevoice": {
      "command": "${root}\\engines\\audio-engines\\audiocpp_cli.exe",
      "args": [
        "--task", "tts", "--family", "vibevoice",
        "--model", "${root}\\models\\speech\\synthesis\\VibeVoice-1.5B-GGUF\\vibevoice-1.5b-q8_0.gguf",
        "--backend", "cuda",
        "--request-option", "voice_samples=${root}\\..\\audio.cpp\\assets\\resources\\b.wav"
      ],
      "mode": "subprocess",
      "requestTimeoutSeconds": 1800,
      "gpu": true
    },
    "fish-audio": {
      "command": "${root}\\engines\\audio-engines\\audiocpp_cli.exe",
      "args": [
        "--task", "tts", "--family", "fish_audio",
        "--model", "${root}\\models\\speech\\synthesis\\Fish-Audio-S2-Pro-GGUF\\fish-audio-s2-pro-q8_0.gguf",
        "--backend", "cuda"
      ],
      "mode": "subprocess",
      "requestTimeoutSeconds": 900,
      "gpu": true
    },
    "chatterbox-clone": {
      "command": "${root}\\engines\\audio-engines\\audiocpp_cli.exe",
      "args": [
        "--task", "clon", "--family", "chatterbox",
        "--model", "${root}\\models\\speech\\conversion\\Chatterbox-GGUF\\chatterbox-q8_0.gguf",
        "--backend", "cuda",
        "--voice-ref", "${root}\\..\\audio.cpp\\assets\\resources\\b.wav"
      ],
      "mode": "subprocess",
      "requestTimeoutSeconds": 900,
      "gpu": true
    },
    "qwen3-asr-0.6b": {
      "command": "${root}\\engines\\audio-engines\\audiocpp_cli.exe",
      "args": [
        "--task", "asr", "--family", "qwen3_asr",
        "--model", "${root}\\models\\transcription\\Qwen3-ASR-0.6B-GGUF\\qwen3-asr-0.6b-q8_0.gguf",
        "--backend", "cuda"
      ],
      "mode": "subprocess",
      "requestTimeoutSeconds": 900,
      "gpu": true
    },
    "qwen3-asr-1.7b": {
      "command": "${root}\\engines\\audio-engines\\audiocpp_cli.exe",
      "args": [
        "--task", "asr", "--family", "qwen3_asr",
        "--model", "${root}\\models\\transcription\\Qwen3-ASR-1.7B-hf",
        "--backend", "cuda"
      ],
      "mode": "subprocess",
      "requestTimeoutSeconds": 1200,
      "gpu": true
    },
    "vibevoice-asr": {
      "command": "${root}\\engines\\audio-engines\\audiocpp_cli.exe",
      "args": [
        "--task", "asr", "--family", "vibevoice_asr",
        "--model", "${root}\\models\\transcription\\VibeVoice-ASR-GGUF\\vibevoice-asr-q8_0.gguf",
        "--backend", "cuda"
      ],
      "mode": "subprocess",
      "requestTimeoutSeconds": 1200,
      "gpu": true
    },
    "voiceconvert": {
      "command": "${root}\\engines\\audio-engines\\audiocpp_cli.exe",
      "args": [
        "--task", "vc",
        "--family", "chatterbox",
        "--model", "${root}\\models\\speech\\conversion\\Chatterbox-GGUF\\chatterbox-q8_0.gguf",
        "--backend", "cuda"
      ],
      "mode": "subprocess",
      "requestTimeoutSeconds": 900,
      "gpu": true
    },
    "vevo2": {
      "command": "${root}\\engines\\audio-engines\\audiocpp_cli.exe",
      "args": [
        "--task", "vc", "--family", "vevo2",
        "--model", "${root}\\models\\speech\\conversion\\Vevo2-GGUF\\vevo2-q8_0.gguf",
        "--backend", "cuda"
      ],
      "mode": "subprocess",
      "requestTimeoutSeconds": 1200,
      "gpu": true
    },
    "music": {
      "command": "${root}\\engines\\audio-engines\\audiocpp_cli.exe",
      "args": [
        "--task", "gen",
        "--family", "ace_step",
        "--model", "${root}\\models\\music\\generation\\ACE-Step1.5-GGUF\\turbo\\ace-step-1.5-turbo-q8_0.gguf",
        "--backend", "cuda",
        "--session-option", "ace_step.mem_saver=true"
      ],
      "mode": "subprocess",
      "requestTimeoutSeconds": 1800,
      "gpu": true
    },
    "stable-audio-medium": {
      "command": "${root}\\engines\\audio-engines\\audiocpp_cli.exe",
      "args": [
        "--task", "gen", "--family", "stable_audio",
        "--model", "${root}\\models\\music\\generation\\Stable-Audio-3-Medium-GGUF\\stable-audio-3-medium-q8_0.gguf",
        "--backend", "cuda", "--session-option", "stable_audio.mem_saver=true"
      ],
      "mode": "subprocess",
      "requestTimeoutSeconds": 1800,
      "gpu": true
    },
    "stable-audio-sfx": {
      "command": "${root}\\engines\\audio-engines\\audiocpp_cli.exe",
      "args": [
        "--task", "gen", "--family", "stable_audio",
        "--model", "${root}\\models\\sound\\generation\\Stable-Audio-3-Small-SFX-GGUF\\stable-audio-3-small-sfx-q8_0.gguf",
        "--backend", "cuda", "--session-option", "stable_audio.mem_saver=true"
      ],
      "mode": "subprocess",
      "requestTimeoutSeconds": 1200,
      "gpu": true
    },
    "heartmula": {
      "command": "${root}\\engines\\audio-engines\\audiocpp_cli.exe",
      "args": [
        "--task", "gen", "--family", "heartmula",
        "--model", "${root}\\models\\music\\generation\\HeartMuLa-GGUF\\heartmula-q8_0.gguf",
        "--backend", "cuda"
      ],
      "mode": "subprocess",
      "requestTimeoutSeconds": 1800,
      "gpu": true
    },
    "htdemucs": {
      "command": "${root}\\engines\\audio-engines\\audiocpp_cli.exe",
      "args": [
        "--task", "sep", "--family", "htdemucs",
        "--model", "${root}\\models\\music\\separation\\HTDemucs-GGUF\\htdemucs-q8_0.gguf",
        "--backend", "cuda"
      ],
      "mode": "subprocess",
      "requestTimeoutSeconds": 1800,
      "gpu": true
    },
    "bs-roformer": {
      "command": "${root}\\engines\\audio-engines\\audiocpp_cli.exe",
      "args": [
        "--task", "sep", "--family", "bs_roformer",
        "--model", "${root}\\models\\music\\separation\\BS-RoFormer-ep368_Q8\\BS-RoFormer-ep368_Q8.gguf",
        "--backend", "cuda"
      ],
      "mode": "subprocess",
      "requestTimeoutSeconds": 1800,
      "gpu": true
    },
    "mel-band-roformer": {
      "command": "${root}\\engines\\audio-engines\\audiocpp_cli.exe",
      "args": [
        "--task", "sep", "--family", "mel_band_roformer",
        "--model", "${root}\\models\\music\\separation\\Mel-Band-RoFormer-GGUF\\mel-band-roformer-q8_0.gguf",
        "--backend", "cuda"
      ],
      "mode": "subprocess",
      "requestTimeoutSeconds": 1800,
      "gpu": true
    },
    "silero-vad": {
      "command": "${root}\\engines\\audio-engines\\audiocpp_cli.exe",
      "args": [
        "--task", "vad", "--family", "silero_vad",
        "--model", "${root}\\models\\speech\\analysis\\VAD\\audio.cpp\\silero_vad",
        "--backend", "cuda"
      ],
      "mode": "subprocess",
      "requestTimeoutSeconds": 300,
      "gpu": true
    },
    "marblenet-vad": {
      "command": "${root}\\engines\\audio-engines\\audiocpp_cli.exe",
      "args": [
        "--task", "vad", "--family", "marblenet_vad",
        "--model", "${root}\\models\\speech\\analysis\\VAD\\audio.cpp\\marblenet_vad",
        "--backend", "cuda"
      ],
      "mode": "subprocess",
      "requestTimeoutSeconds": 300,
      "gpu": true
    },
    "forced-aligner": {
      "command": "${root}\\engines\\audio-engines\\audiocpp_cli.exe",
      "args": [
        "--task", "align", "--family", "qwen3_forced_aligner",
        "--model", "${root}\\models\\speech\\analysis\\alignment\\Qwen3-ForcedAligner-0.6B-GGUF\\qwen3-forced-aligner-0.6b-q8_0.gguf",
        "--backend", "cuda"
      ],
      "mode": "subprocess",
      "requestTimeoutSeconds": 900,
      "gpu": true
    },
    "diarize": {
      "command": "${root}\\engines\\audio-engines\\audiocpp_cli.exe",
      "args": [
        "--task", "diar",
        "--family", "sortformer_diar",
        "--model", "${root}\\models\\speech\\analysis\\diarization\\Sortformer-Diar-4spk-v1-GGUF\\sortformer-diar-4spk-v1-q8_0.gguf",
        "--backend", "cuda"
      ],
      "mode": "subprocess",
      "requestTimeoutSeconds": 300,
      "gpu": true
    },
    "diarize-sherpa": {
      "command": "${root}\\engines\\sherpa-onnx\\sherpa-onnx-v1.13.4-win-x64-shared-MD-Release\\bin\\sherpa-onnx-offline-speaker-diarization.exe",
      "args": [
        "--segmentation.pyannote-model=${root}\\models\\speech\\analysis\\diarization\\sherpa-onnx-pyannote-segmentation-3-0\\model.onnx",
        "--embedding.model=${root}\\models\\speech\\analysis\\speaker-embedding\\nemo_en_titanet_small.onnx",
        "--clustering.cluster-threshold=0.8"
      ],
      "mode": "subprocess",
      "requestTimeoutSeconds": 300
    },
    "sd": {
      "command": "${root}\\engines\\sd-engines\\sd-server.exe",
      "args": [
        "--listen-ip", "127.0.0.1",
        "--listen-port", "8737",
        "-m", "${root}\\models\\image\\generation\\Stable-Diffusion-1.5\\v1-5-pruned-emaonly.safetensors",
        "--type", "f16",
        "--diffusion-fa",
        "--vae-tiling"
      ],
      "mode": "server",
      "healthUrl": "http://127.0.0.1:8737/v1/models",
      "startupTimeoutSeconds": 60,
      "shutdownTimeoutSeconds": 10,
      "requestTimeoutSeconds": 300
    }
  }
}
